@model FollowUpViewModel
@{ ViewData["Title"] = "Schedule Follow-Up"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-calendar-plus me-2"></i>Schedule Follow-Up</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" id="followUpForm" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Subject" class="form-label fw-semibold small"></label>
                    <input asp-for="Subject" class="form-control"
                           placeholder="Brief description of this follow-up" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FollowUpType" class="form-label fw-semibold small"></label>
                    <select asp-for="FollowUpType" class="form-select">
                        <option value="Call">📞 Call</option>
                        <option value="Email">✉️ Email</option>
                        <option value="Meeting">👥 Meeting</option>
                        <option value="Task">✅ Task</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="FollowUpDate" class="form-label fw-semibold small"></label>
                    <input asp-for="FollowUpDate" class="form-control" type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" id="followUpDateInput" />
                    <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                    <div id="dateError" class="text-danger small d-none">
                        Follow-up date cannot be earlier than today.
                    </div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label fw-semibold small"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Planned">Planned</option>
                        <option value="Completed">Completed</option>
                        <option value="Missed">Missed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssignedTo" class="form-label fw-semibold small"></label>
                    <select asp-for="AssignedTo" asp-items="Model.SalesUsers" class="form-select">
                        <option value="">-- Assign To --</option>
                    </select>
                </div>

                <div class="col-12"><hr class="my-1" /><p class="text-muted small mb-2">Link this follow-up to (choose one):</p></div>

                <div class="col-md-4">
                    <label asp-for="CustomerId" class="form-label fw-semibold small"></label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="LeadId" class="form-label fw-semibold small"></label>
                    <select asp-for="LeadId" asp-items="Model.Leads" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="OpportunityId" class="form-label fw-semibold small"></label>
                    <select asp-for="OpportunityId" asp-items="Model.Opportunities" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="Remarks" class="form-label fw-semibold small"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="3"
                              placeholder="Notes or remarks for this follow-up..."></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-calendar-check me-1"></i>Schedule Follow-Up
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Client-side: follow-up date cannot be in the past
        document.getElementById('followUpForm').addEventListener('submit', function (e) {
            const dateVal  = document.getElementById('followUpDateInput').value;
            const dateErr  = document.getElementById('dateError');
            const today    = new Date(); today.setHours(0,0,0,0);

            if (dateVal) {
                const chosen = new Date(dateVal); chosen.setHours(0,0,0,0);
                if (chosen < today) {
                    dateErr.classList.remove('d-none');
                    e.preventDefault();
                    return;
                }
            }
            dateErr.classList.add('d-none');
        });
    </script>
}
