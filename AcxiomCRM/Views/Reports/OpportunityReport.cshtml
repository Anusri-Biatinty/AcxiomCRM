@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Opportunity Report"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-handshake me-2"></i>Opportunity Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <form asp-action="OpportunityReport" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <select name="stage" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    @foreach (var s in new[]{"Qualification","Proposal","Negotiation","Won","Lost"})
                    { <option value="@s" selected="@(ViewBag.Stage==s)">@s</option> }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="OpportunityReport" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-primary">@Model.Count()</div>
            <div class="small text-muted">Total</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-success">@Model.Count(o=>o.Stage=="Won")</div>
            <div class="small text-muted">Won</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-info">₹@Model.Sum(o=>o.Amount).ToString("N0")</div>
            <div class="small text-muted">Total Amount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-warning">₹@Model.Sum(o=>o.WeightedAmount).ToString("N0")</div>
            <div class="small text-muted">Weighted Amount</div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Probability</th>
                        <th>Weighted</th>
                        <th>Close Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@o.OpportunityName</td>
                            <td>@o.Customer?.CustomerName</td>
                            <td>
                                @{var sc=o.Stage switch{"Won"=>"bg-success","Lost"=>"bg-danger","Negotiation"=>"bg-warning","Proposal"=>"bg-info",_=>"bg-primary"};}
                                <span class="badge @sc">@o.Stage</span>
                            </td>
                            <td>₹@o.Amount.ToString("N0")</td>
                            <td>@o.Probability%</td>
                            <td class="text-muted">₹@o.WeightedAmount.ToString("N0")</td>
                            <td class="@(o.ExpectedCloseDate<DateTime.Today&&o.Stage!="Won"&&o.Stage!="Lost"?"text-danger":"")">
                                @o.ExpectedCloseDate.ToString("dd MMM yyyy")
                            </td>
                            <td><span class="badge @(o.Status=="Open"?"bg-success":"bg-secondary")">@o.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No opportunities found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
