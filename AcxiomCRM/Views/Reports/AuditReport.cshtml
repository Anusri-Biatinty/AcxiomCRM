@model IEnumerable<AuditLog>
@{ ViewData["Title"] = "Audit Report"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-shield-alt me-2"></i>Audit Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <form asp-action="AuditReport" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <select name="action" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    @foreach (var a in new[]{"Login","Logout","FailedLogin","Create","Update","Delete","RoleChange"})
                    { <option value="@a" selected="@(ViewBag.Action==a)">@a</option> }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" class="form-control form-control-sm" placeholder="From" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" class="form-control form-control-sm" placeholder="To" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="AuditReport" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record</th>
                        <th>Result</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small text-nowrap text-muted">@log.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td class="small">@log.UserName</td>
                            <td>
                                @{var ac=log.Action switch{"Login"=>"bg-success","Logout"=>"bg-secondary","FailedLogin" or "AccountLocked"=>"bg-danger","Create"=>"bg-primary","Update"=>"bg-warning","Delete" or "Deactivate"=>"bg-danger","RoleChange" or "PasswordReset"=>"bg-info",_=>"bg-secondary"};}
                                <span class="badge @ac">@log.Action</span>
                            </td>
                            <td class="small">@log.EntityName</td>
                            <td class="small text-muted">@log.RecordId</td>
                            <td><span class="badge @(log.Result=="Success"?"bg-success":"bg-danger")">@log.Result</span></td>
                            <td class="small text-muted">@log.IpAddress</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No audit records.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small bg-white">@Model.Count() records (max 300)</div>
</div>
