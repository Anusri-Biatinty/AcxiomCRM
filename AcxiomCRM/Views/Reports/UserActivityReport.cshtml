@model IEnumerable<dynamic>
@{ ViewData["Title"] = "User Activity Report"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-user-clock me-2"></i>User Activity Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Total Actions</th>
                        <th>Last Activity</th>
                        <th>Activity Bar</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var dataList = Model.ToList();
                        int maxActions = dataList.Any() ? (int)dataList.Max(r => r.TotalActions) : 1;
                        int rank = 1;
                    }
                    @foreach (var row in dataList)
                    {
                        var pct = maxActions > 0 ? (int)row.TotalActions * 100 / maxActions : 0;
                        <tr>
                            <td class="text-muted small">@(rank++)</td>
                            <td class="fw-semibold">@row.UserName</td>
                            <td>
                                <span class="badge bg-primary">@row.TotalActions</span>
                            </td>
                            <td class="small text-muted">
                                @((DateTime)row.LastActivity).ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td style="width:200px">
                                <div class="progress" style="height:8px">
                                    <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!dataList.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No activity data.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
