@model IEnumerable<Lead>
@{ ViewData["Title"] = "Lead Report"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-filter me-2"></i>Lead Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Reports
    </a>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <form asp-action="LeadReport" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @foreach (var s in new[] { "New","Contacted","Qualified","Unqualified","Converted","Lost" })
                    { <option value="@s" selected="@(ViewBag.Status == s)">@s</option> }
                </select>
            </div>
            <div class="col-md-3">
                <select name="source" class="form-select form-select-sm">
                    <option value="">All Sources</option>
                    @foreach (var s in new[] { "Website","Referral","Cold Call","Social Media","Event","Other" })
                    { <option value="@s" selected="@(ViewBag.Source == s)">@s</option> }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-action="LeadReport" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Summary cards -->
<div class="row g-2 mb-3">
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-primary">@Model.Count()</div>
            <div class="small text-muted">Total</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-success">@Model.Count(l => l.Status == "Qualified")</div>
            <div class="small text-muted">Qualified</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-info">@Model.Count(l => l.Status == "Converted")</div>
            <div class="small text-muted">Converted</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-danger">@Model.Count(l => l.Status == "Lost")</div>
            <div class="small text-muted">Lost</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center py-2">
            <div class="fw-bold fs-5 text-warning">₹@Model.Sum(l => l.ExpectedValue).ToString("N0")</div>
            <div class="small text-muted">Total Expected Value</div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Expected Value</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@l.CompanyName</td>
                            <td>@l.Source</td>
                            <td>
                                @{
                                    var sc = l.Status switch {
                                        "New"=>"bg-primary","Contacted"=>"bg-info","Qualified"=>"bg-success",
                                        "Converted"=>"bg-dark","Lost"=>"bg-danger",_=>"bg-secondary"
                                    };
                                }
                                <span class="badge @sc">@l.Status</span>
                            </td>
                            <td>
                                @{
                                    var pc = l.Priority == "High" ? "bg-danger"
                                        : l.Priority == "Medium" ? "bg-warning" : "bg-success";
                                }
                                <span class="badge @pc">@l.Priority</span>
                            </td>
                            <td>₹@l.ExpectedValue.ToString("N0")</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No leads found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small bg-white">Total: @Model.Count() leads</div>
</div>
