@model IEnumerable<dynamic>
@{ ViewData["Title"] = "Pipeline Report"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-funnel-dollar me-2"></i>Pipeline Report</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Reports</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Stage</th>
                        <th>Count</th>
                        <th>Total Amount</th>
                        <th>Weighted Amount</th>
                        <th>Pipeline Share</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var dataList = Model.ToList();
                        decimal grandTotal = 0;
                        foreach (var row in dataList)
                            grandTotal += (decimal)row.TotalAmount;
                    }
                    @foreach (var row in dataList)
                    {
                        var pct = grandTotal > 0 ? (decimal)row.TotalAmount / grandTotal * 100 : 0;
                        <tr>
                            <td>
                                @{
                                    var sc = ((string)row.Stage) switch {
                                        "Negotiation"=>"bg-warning","Proposal"=>"bg-info",_=>"bg-primary"
                                    };
                                }
                                <span class="badge @sc">@row.Stage</span>
                            </td>
                            <td>@row.Count</td>
                            <td class="fw-semibold text-success">₹@((decimal)row.TotalAmount).ToString("N0")</td>
                            <td class="text-info">₹@((decimal)row.WeightedAmount).ToString("N0")</td>
                            <td style="width:200px">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px">
                                        <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                    </div>
                                    <span class="small">@pct.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!dataList.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No open pipeline data.</td></tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td>TOTAL</td>
                        <td>@dataList.Sum(r => (int)r.Count)</td>
                        <td class="text-success">₹@grandTotal.ToString("N0")</td>
                        <td class="text-info">₹@dataList.Sum(r => (decimal)r.WeightedAmount).ToString("N0")</td>
                        <td>100%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
