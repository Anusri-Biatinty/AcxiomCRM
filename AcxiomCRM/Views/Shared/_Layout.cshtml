<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AcxiomCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-5" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-chart-line me-2"></i>AcxiomCRM
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">
                            <i class="fas fa-users me-1"></i>Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Lead" asp-action="Index">
                            <i class="fas fa-filter me-1"></i>Leads
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Opportunity" asp-action="Index">
                            <i class="fas fa-handshake me-1"></i>Opportunities
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="FollowUp" asp-action="Index">
                            <i class="fas fa-calendar-check me-1"></i>Follow-Ups
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-chart-bar me-1"></i>Reports
                            </a>
                            <ul class="dropdown-menu shadow">
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="CustomerReport">
                                    <i class="fas fa-users me-2 text-primary"></i>Customer Report</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="LeadReport">
                                    <i class="fas fa-filter me-2 text-warning"></i>Lead Report</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="OpportunityReport">
                                    <i class="fas fa-handshake me-2 text-info"></i>Opportunity Report</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="PipelineReport">
                                    <i class="fas fa-funnel-dollar me-2 text-success"></i>Pipeline Report</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="FollowUpReport">
                                    <i class="fas fa-calendar me-2 text-secondary"></i>Follow-Up Report</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="UserActivityReport">
                                    <i class="fas fa-user-clock me-2 text-dark"></i>User Activity</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="AuditReport">
                                        <i class="fas fa-shield-alt me-2 text-danger"></i>Audit Report</a></li>
                                }
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="UserManagement" asp-action="Index">
                                <i class="fas fa-user-cog me-1"></i>Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="AuditLog" asp-action="Index">
                                <i class="fas fa-shield-alt me-1"></i>Audit Log
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i>
                            @User.Identity!.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}

<div class="container-fluid py-3 px-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
