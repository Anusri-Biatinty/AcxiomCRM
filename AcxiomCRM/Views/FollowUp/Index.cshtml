@model IEnumerable<FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-calendar-check me-2"></i>Follow-Ups</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Schedule Follow-Up
    </a>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    @foreach (var s in new[] { "Planned", "Completed", "Missed", "Cancelled" })
                    {
                        <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="date" class="form-control form-control-sm"
                       title="Filter by date" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Overdue Alert -->
@{
    var overdue = Model.Where(f => f.Status == "Planned" && f.FollowUpDate < DateTime.Today).ToList();
}
@if (overdue.Any())
{
    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="fas fa-exclamation-triangle me-3 fs-5"></i>
        <div>
            <strong>@overdue.Count overdue planned follow-up(s)</strong> — these were scheduled in the past and still marked Planned.
        </div>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Related To</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                        <tr class="@(isOverdue ? "table-warning" : "")">
                            <td class="@(isOverdue ? "text-danger fw-bold" : "")">
                                @f.FollowUpDate.ToString("dd MMM yyyy")
                                @if (isOverdue) { <i class="fas fa-exclamation-circle ms-1 text-danger"></i> }
                            </td>
                            <td class="fw-semibold">@f.Subject</td>
                            <td>
                                @{
                                    var typeIcon = f.FollowUpType switch {
                                        "Call" => "fas fa-phone", "Email" => "fas fa-envelope",
                                        "Meeting" => "fas fa-users", _ => "fas fa-tasks"
                                    };
                                }
                                <i class="@typeIcon me-1 text-muted"></i>@f.FollowUpType
                            </td>
                            <td class="small text-muted">
                                @if (f.Customer != null)
                                { <span><i class="fas fa-user me-1"></i>@f.Customer.CustomerName</span> }
                                else if (f.Lead != null)
                                { <span><i class="fas fa-filter me-1"></i>@f.Lead.LeadName</span> }
                                else
                                { <span class="text-muted">—</span> }
                            </td>
                            <td>
                                @{
                                    var stClass = f.Status switch {
                                        "Completed" => "bg-success", "Missed" => "bg-danger",
                                        "Cancelled" => "bg-secondary", _ => "bg-primary"
                                    };
                                }
                                <span class="badge @stClass">@f.Status</span>
                            </td>
                            <td class="small text-muted" style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @f.Remarks
                            </td>
                            <td class="text-end">
                                @if (f.Status == "Planned")
                                {
                                    <form asp-action="Complete" asp-route-id="@f.FollowUpId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Mark as Completed?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Complete">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Cancel" asp-route-id="@f.FollowUpId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this follow-up?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancel">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fas fa-calendar fa-2x mb-2 d-block opacity-25"></i>
                                No follow-ups found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small bg-white">
        Showing @Model.Count() | Pending: @Model.Count(f => f.Status == "Planned")
    </div>
</div>
