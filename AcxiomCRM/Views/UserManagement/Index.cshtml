@model IEnumerable<ApplicationUser>
@{ ViewData["Title"] = "User Management"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0"><i class="fas fa-user-cog me-2"></i>User Management</h4>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>Add User
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Lockout</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
                    }
                    @foreach (var u in Model)
                    {
                        var roles    = userRoles?.ContainsKey(u.Id) == true ? userRoles[u.Id] : new List<string>();
                        var roleStr  = string.Join(", ", roles);
                        var isLocked = u.LockoutEnd.HasValue && u.LockoutEnd > DateTimeOffset.UtcNow;
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>
                            <td>@u.Email</td>
                            <td>
                                @{
                                    var roleClass = roleStr switch {
                                        "Admin"         => "bg-danger",
                                        "Manager"       => "bg-warning",
                                        "SalesExecutive"=> "bg-primary",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @roleClass">@roleStr</span>
                            </td>
                            <td>
                                <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-lock me-1"></i>Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-muted small">@u.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                    <!-- Toggle Active -->
                                    <form asp-action="ToggleActive" method="post" class="d-inline"
                                          onsubmit="return confirm('@(u.IsActive ? "Deactivate" : "Activate") @u.FullName?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit"
                                                class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                                title="@(u.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(u.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                        </button>
                                    </form>

                                    <!-- Change Role -->
                                    <div class="d-inline">
                                        <form asp-action="ChangeRole" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <div class="input-group input-group-sm">
                                                <select name="newRole" class="form-select form-select-sm">
                                                    <option value="Admin"          selected="@(roleStr=="Admin")">Admin</option>
                                                    <option value="Manager"        selected="@(roleStr=="Manager")">Manager</option>
                                                    <option value="SalesExecutive" selected="@(roleStr=="SalesExecutive")">SalesExecutive</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-info" title="Change Role">
                                                    <i class="fas fa-exchange-alt"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Reset Password -->
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id"
                                            title="Reset Password">
                                        <i class="fas fa-key"></i>
                                    </button>

                                    <!-- Unlock Account -->
                                    @if (isLocked)
                                    {
                                        <form asp-action="UnlockAccount" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Unlock Account">
                                                <i class="fas fa-lock-open"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>

                        <!-- Reset Password Modal -->
                        <div class="modal fade" id="resetModal-@u.Id" tabindex="-1">
                            <div class="modal-dialog modal-sm">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h6 class="modal-title">Reset Password — @u.FullName</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="ResetPassword" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <div class="modal-body">
                                            <label class="form-label small fw-semibold">New Password</label>
                                            <input type="password" name="newPassword" class="form-control"
                                                   placeholder="Min 8 chars, upper, lower, digit, symbol"
                                                   required minlength="8" />
                                        </div>
                                        <div class="modal-footer py-2">
                                            <button type="button" class="btn btn-sm btn-secondary"
                                                    data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-warning">Reset</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small bg-white">@Model.Count() users</div>
</div>
